NAMED_VERBS = ("post", "claim", "release", "done", "blocked", "inbox")


def main():
    p = argparse.ArgumentParser(prog="swarm-board", description=__doc__,
                               formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--root", default="", help="board root; beats $SWARM_BOARD_ROOT")
    p.add_argument("--run", required=True, help="swarm run id")
    # No default identity. `--me` used to fall back to "anon", so a peer that
    # dropped the flag posted the most findings in the run under a name that
    # identified nobody, and the harvest had to guess who held the lock (rsi1:
    # 20 findings as "anon"). Identity-bearing verbs now refuse to guess.
    p.add_argument("--me", default="", help="your agent name (required for write verbs)")
    sub = p.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("post"); s.add_argument("thread"); s.add_argument("message", nargs="*"); s.add_argument("--stdin", action="store_true", help="read the message from stdin (safe against shell expansion)"); s.set_defaults(fn=cmd_post)
    s = sub.add_parser("inbox"); s.add_argument("--all", action="store_true"); s.set_defaults(fn=cmd_inbox)
    s = sub.add_parser("claim"); s.add_argument("slice"); s.add_argument("--note", default=""); s.set_defaults(fn=cmd_claim)
    s = sub.add_parser("release"); s.add_argument("slice"); s.set_defaults(fn=cmd_release)
    s = sub.add_parser("claims"); s.set_defaults(fn=cmd_claims)
    s = sub.add_parser("reap"); s.add_argument("--older-than", type=float, default=1800); s.set_defaults(fn=cmd_reap)
    s = sub.add_parser("rescue"); s.add_argument("slice"); s.add_argument("--stale-after", type=int, default=300); s.add_argument("--force", action="store_true"); s.set_defaults(fn=cmd_rescue)
    s = sub.add_parser("team"); s.set_defaults(fn=cmd_team)
    s = sub.add_parser("done"); s.add_argument("reason", nargs="+"); s.add_argument("--artifact", default=""); s.set_defaults(fn=cmd_done)
    s = sub.add_parser("blocked"); s.add_argument("reason", nargs="+"); s.set_defaults(fn=cmd_blocked)
    s = sub.add_parser("budget"); s.set_defaults(fn=cmd_budget)
    s = sub.add_parser("goal"); s.add_argument("--set", default=""); s.set_defaults(fn=cmd_goal)
    s = sub.add_parser("log"); s.add_argument("--thread", default=""); s.add_argument("--tail", type=int, default=50); s.set_defaults(fn=cmd_log)

    a = p.parse_args()
    if not a.me.strip() and a.cmd in NAMED_VERBS:
        die(f"{a.cmd} needs --me <name>; it is how peers know who you are")
    apply_root(a.root)
    # Repair every user-supplied string once, here.
    for field in ("run", "me", "slice", "message", "reason", "thread", "note", "artifact", "set"):
        if hasattr(a, field):
            setattr(a, field, argv_text(getattr(a, field)))
    a.fn(a)


if __name__ == "__main__":
    main()
