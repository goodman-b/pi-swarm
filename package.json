    "pi",
    "pi-coding-agent",
    "pi-extension",
    "extension",
    "swarm",
    "multi-agent",
    "subagents",
    "agents",
    "orchestration",
    "parallel-agents",
    "shared-board"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
